<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🌾 CropWise Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    /* Weather Banner styles for EJS Dashboard */
    .weather-banner {
      background: linear-gradient(135deg, #1e88e5 0%, #00acc1 100%);
      color: white;
      border-radius: 15px;
      padding: 25px;
      margin-bottom: 30px;
      box-shadow: 0 8px 24px rgba(0, 172, 193, 0.2);
    }
    .weather-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
      margin-bottom: 20px;
    }
    .weather-city-info h3 {
      font-size: 26px;
      color: white;
      margin: 0 0 5px 0;
    }
    .weather-city-info p {
      margin: 0;
      color: #e0f7fa;
      font-size: 15px;
      text-transform: capitalize;
    }
    .weather-live-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.2);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      backdrop-filter: blur(4px);
    }
    .pulse-green {
      width: 10px;
      height: 10px;
      background: #4ade80;
      border-radius: 50%;
      display: inline-block;
      box-shadow: 0 0 8px #4ade80;
    }
    .weather-main-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 20px;
    }
    @media (max-width: 768px) {
      .weather-main-grid {
        grid-template-columns: 1fr;
      }
    }
    .weather-temp-box {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .weather-big-icon {
      font-size: 48px;
      margin-bottom: 5px;
    }
    .weather-temp-val {
      font-size: 42px;
      font-weight: bold;
      line-height: 1;
    }
    .weather-feels {
      font-size: 13px;
      color: #b2ebf2;
      margin-top: 6px;
    }
    .weather-metrics-subgrid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 12px;
    }
    .weather-metric-item {
      background: rgba(255, 255, 255, 0.15);
      padding: 12px 15px;
      border-radius: 10px;
      backdrop-filter: blur(4px);
    }
    .weather-metric-item .label {
      display: block;
      font-size: 12px;
      color: #b2ebf2;
      margin-bottom: 4px;
    }
    .weather-metric-item .val {
      font-size: 20px;
      font-weight: bold;
      color: white;
    }
    .user-pill {
      display: inline-block;
      margin-left: 15px;
      font-size: 14px;
      font-weight: normal;
      background: rgba(255, 255, 255, 0.2);
      padding: 4px 12px;
      border-radius: 12px;
    }
    .nav-btn-spa {
      background: #4caf50 !important;
      color: white !important;
      font-weight: bold !important;
    }
    .rec-box {
      background: #f0fdf4;
      border-left: 4px solid #22c55e;
      padding: 15px;
      border-radius: 8px;
      margin-top: 10px;
    }
    .rec-item {
      margin: 8px 0;
      color: #166534;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
  </style>
</head>
<body>

  <!-- Navigation Header -->
  <header class="navbar">
    <div class="navbar-container">
      <div class="navbar-brand">
        <h2>🌾 CropWise <span class="user-pill">👤 <%= user.name %> | 🌱 <%= user.crop %> | 📏 <%= user.farmSize %></span></h2>
      </div>
      <nav class="navbar-menu">
        <a href="/dashboard" class="active">📊 Dashboard</a>
        <a href="/profile">👤 Profile</a>
        <a href="/" target="_blank" class="nav-btn-spa" title="Launch modern SPA with AI vision, multi-language & smart interactive features">🚀 Interactive App</a>
        <a href="/impl1" target="_blank" title="Launch farm simulation">🌾 Simulation</a>
        <a href="/logout" class="btn-logout">🚪 Logout</a>
      </nav>
    </div>
  </header>

  <div class="container">
    
    <!-- Weather Section -->
    <section class="section">
      <h2 class="section-title">🌤️ Real-Time Weather (<%= data.weather?.location || user.location || 'Farm Location' %>)</h2>
      <div class="weather-banner">
        <div class="weather-header-row">
          <div class="weather-city-info">
            <h3><%= data.weather?.location || user.location || 'Farm Location' %></h3>
            <p><%= data.weather?.condition || data.weather?.description || 'Partly cloudy' %></p>
          </div>
          <div class="weather-live-tag">
            <span class="pulse-green"></span>
            <%= data.weather?.source === 'open-meteo' ? 'Open-Meteo Worldwide Live' : data.weather?.source === 'openweathermap' ? 'OpenWeatherMap Live' : 'Simulated Weather Sync' %>
          </div>
        </div>

        <div class="weather-main-grid">
          <div class="weather-temp-box">
            <div class="weather-big-icon">
              <% const icon = data.weather?.icon || 'Clouds'; %>
              <%= icon === 'Clear' ? '☀️' : icon === 'Rain' ? '🌧️' : icon === 'Thunderstorm' ? '⛈️' : icon === 'Drizzle' ? '🌦️' : icon === 'Snow' ? '❄️' : '⛅' %>
            </div>
            <div class="weather-temp-val"><%= data.weather?.temp ?? 30 %>°C</div>
            <div class="weather-feels">Feels like <%= data.weather?.feelsLike ?? data.weather?.temp ?? 30 %>°C</div>
          </div>

          <div class="weather-metrics-subgrid">
            <div class="weather-metric-item">
              <span class="label">💧 Humidity</span>
              <span class="val"><%= data.weather?.humidity ?? 60 %>%</span>
            </div>
            <div class="weather-metric-item">
              <span class="label">💨 Wind Speed</span>
              <span class="val"><%= data.weather?.wind_kph ?? data.weather?.windSpeed ?? 12 %> km/h</span>
            </div>
            <div class="weather-metric-item">
              <span class="label">🔻 Pressure</span>
              <span class="val"><%= data.weather?.pressure ?? 1013 %> hPa</span>
            </div>
            <div class="weather-metric-item">
              <span class="label">☁️ Cloud Cover</span>
              <span class="val"><%= data.weather?.cloudiness ?? 20 %>%</span>
            </div>
            <div class="weather-metric-item">
              <span class="label">🌧️ Rainfall</span>
              <span class="val"><%= data.weather?.rainfall ?? 0 %> mm</span>
            </div>
            <div class="weather-metric-item">
              <span class="label">☀️ UV Index</span>
              <span class="val"><%= data.weather?.uv_index ?? 7 %>/11</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Real-time Sensor Data -->
    <section class="section">
      <h2 class="section-title">📊 Real-Time Field Sensor Data</h2>
      <div class="grid">
        <div class="card stat-card moisture">
          <div class="icon">💧</div>
          <h3>Soil Moisture</h3>
          <p class="stat-value"><%= data.moisture %>%</p>
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= data.moisture %>%; background: #2196F3;"></div>
          </div>
          <span class="stat-label">Optimal Band: 35-45%</span>
        </div>

        <div class="card stat-card temp">
          <div class="icon">🌡️</div>
          <h3>Temperature</h3>
          <p class="stat-value"><%= data.temperature %>°C</p>
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= (data.temperature / 50) * 100 %>%; background: #FF5722;"></div>
          </div>
          <span class="stat-label">Normal Range: 25-35°C</span>
        </div>

        <div class="card stat-card humidity">
          <div class="icon">☁️</div>
          <h3>Humidity</h3>
          <p class="stat-value"><%= data.humidity %>%</p>
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= data.humidity %>%; background: #4CAF50;"></div>
          </div>
          <span class="stat-label">Good Range: 50-70%</span>
        </div>

        <div class="card stat-card rainfall">
          <div class="icon">🌧️</div>
          <h3>Rainfall (24h)</h3>
          <p class="stat-value"><%= data.rainfall %> mm</p>
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= Math.min(100, (data.rainfall / 20) * 100) %>%; background: #03A9F4;"></div>
          </div>
          <span class="stat-label">Precipitation Log</span>
        </div>
      </div>
    </section>

    <!-- Water Requirement Section -->
    <section class="section">
      <h2 class="section-title">💧 Crop Water Management (<%= user.crop %>)</h2>
      <div class="grid-2">
        <div class="card water-req-card">
          <h3>Seasonal Water Analysis</h3>
          <div class="water-stats">
            <div class="water-stat-item">
              <span class="label">Required</span>
              <span class="value required"><%= data.cropWaterReq %> L</span>
            </div>
            <div class="water-stat-item">
              <span class="label">Applied</span>
              <span class="value used"><%= data.actualWaterUsed %> L</span>
            </div>
            <div class="water-stat-item">
              <span class="label">Remaining Deficit</span>
              <span class="value deficit"><%= data.waterDeficit %> L</span>
            </div>
          </div>
          <div class="water-progress">
            <div class="water-progress-fill" style="width: <%= Math.min(100, (data.actualWaterUsed / Math.max(1, data.cropWaterReq)) * 100) %>%"></div>
          </div>
          <p class="efficiency">⚡ Irrigation Efficiency Score: <strong><%= data.efficiencyScore %>%</strong></p>
        </div>

        <div class="card irrigation-status-card">
          <h3>🚿 Irrigation Status</h3>
          <div class="status-indicator <%= (data.irrigationStatus || 'active').toLowerCase() %>">
            <span class="status-dot"></span>
            <span class="status-text"><%= data.irrigationStatus || 'Active' %></span>
          </div>
          <div class="irrigation-details">
            <div class="detail-row">
              <span class="detail-label">Current Zone:</span>
              <span class="detail-value"><%= data.currentZone || 'Zone 1' %></span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Time Remaining:</span>
              <span class="detail-value"><%= data.timeRemaining || '12 minutes' %></span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Next Schedule:</span>
              <span class="detail-value"><%= data.nextSchedule || 'Tomorrow 6:00 AM' %></span>
            </div>
          </div>
          <a href="/impl1" target="_blank" class="control-btn" style="text-align: center; display: block; text-decoration: none; margin-top: 15px;">🎮 Open Irrigation Simulator</a>
        </div>
      </div>
    </section>

    <!-- Charts Section -->
    <section class="section">
      <h2 class="section-title">📈 Weekly Trends</h2>
      <div class="grid-2">
        <div class="card chart-card">
          <h3>Soil Moisture (7 Days)</h3>
          <canvas id="moistureChart"></canvas>
        </div>

        <div class="card chart-card">
          <h3>Temperature Trends (°C)</h3>
          <canvas id="tempChart"></canvas>
        </div>
      </div>

      <div class="card chart-card-full">
        <h3>💦 Daily Water Usage (Liters)</h3>
        <canvas id="waterUsageChart"></canvas>
      </div>
    </section>

    <!-- AI & Weather Recommendations -->
    <section class="section">
      <h2 class="section-title">🤖 AI Agronomist Recommendations</h2>
      <div class="card recommendation-card" style="width: 100%; max-width: none;">
        <h3>💡 Crop & Irrigation Advisory for <%= user.crop %></h3>
        <div class="rec-box">
          <% if (data.recommendations && data.recommendations.length > 0) { %>
            <% data.recommendations.forEach(function(rec) { %>
              <div class="rec-item">
                <span>🌱</span>
                <strong><%= rec %></strong>
              </div>
            <% }); %>
          <% } else { %>
            <div class="rec-item">
              <span>✓</span>
              <strong><%= data.recommendation || 'Soil moisture and weather conditions are optimal.' %></strong>
            </div>
          <% } %>
        </div>
      </div>
    </section>

  </div>

  <script>
    // Data from server
    const weekDays = <%- JSON.stringify(data.weeklyDays || ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']) %>;
    const moistureData = <%- JSON.stringify(data.weeklyMoisture || [35, 28, 32, 25, 28, 30, 28]) %>;
    const tempData = <%- JSON.stringify(data.weeklyTemp || [28, 30, 32, 31, 32, 29, 30]) %>;
    const waterUsageData = <%- JSON.stringify(data.weeklyWaterUsage || [420, 380, 450, 390, 380, 410, 380]) %>;

    // Chart.js default config
    Chart.defaults.font.family = "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif";
    Chart.defaults.responsive = true;
    Chart.defaults.maintainAspectRatio = true;

    // Moisture Chart
    const ctxMoisture = document.getElementById('moistureChart')?.getContext('2d');
    if (ctxMoisture) {
      new Chart(ctxMoisture, {
        type: 'line',
        data: {
          labels: weekDays,
          datasets: [{
            label: 'Soil Moisture %',
            data: moistureData,
            borderColor: '#2196F3',
            backgroundColor: 'rgba(33, 150, 243, 0.1)',
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            pointRadius: 5,
            pointBackgroundColor: '#2196F3'
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: {
            y: {
              beginAtZero: true,
              max: 60,
              ticks: { callback: value => value + '%' }
            }
          }
        }
      });
    }

    // Temperature Chart
    const ctxTemp = document.getElementById('tempChart')?.getContext('2d');
    if (ctxTemp) {
      new Chart(ctxTemp, {
        type: 'line',
        data: {
          labels: weekDays,
          datasets: [{
            label: 'Temperature °C',
            data: tempData,
            borderColor: '#FF5722',
            backgroundColor: 'rgba(255, 87, 34, 0.1)',
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            pointRadius: 5,
            pointBackgroundColor: '#FF5722'
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { callback: value => value + '°C' }
            }
          }
        }
      });
    }

    // Water Usage Chart
    const ctxWater = document.getElementById('waterUsageChart')?.getContext('2d');
    if (ctxWater) {
      new Chart(ctxWater, {
        type: 'bar',
        data: {
          labels: weekDays,
          datasets: [{
            label: 'Water Usage (Liters)',
            data: waterUsageData,
            backgroundColor: [
              'rgba(33, 150, 243, 0.7)',
              'rgba(3, 169, 244, 0.7)',
              'rgba(0, 188, 212, 0.7)',
              'rgba(0, 150, 136, 0.7)',
              'rgba(76, 175, 80, 0.7)',
              'rgba(139, 195, 74, 0.7)',
              'rgba(205, 220, 57, 0.7)'
            ],
            borderColor: [
              '#2196F3',
              '#03A9F4',
              '#00BCD4',
              '#009688',
              '#4CAF50',
              '#8BC34A',
              '#CDDC39'
            ],
            borderWidth: 2
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { callback: value => value + ' L' }
            }
          }
        }
      });
    }
  </script>

</body>
</html>
